{
  "name": "curso.dev",
  "version": "1.0.0",
  "description": "Projeto desenvolvido para estudo de novas tecnologias, com base no curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:dev:up && next dev -p 3001",
    "services:dev:up": "docker-compose -f infra/compose.yml up database_dev -d",
    "services:dev:down": "docker-compose -f infra/compose.yml down database_dev",
    "services:test:up": "docker-compose -f infra/compose.yml up database_test -d",
    "services:test:down": "docker-compose -f infra/compose.yml down database_test",
    "services:up": "docker-compose -f infra/compose.yml up -d",
    "services:down": "docker-compose -f infra/compose.yml down",
    "services:stop": "docker-compose -f infra/compose.yml stop",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "dotenv -e .env.test -- jest --runInBand",
    "test:watch": "dotenv -e .env.test -- jest --watchAll --runInBand",
    "test:unit": "dotenv -e .env.test -- jest --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "dotenv -e .env.test -- jest --runInBand tests/integration",
    "test:db:reset": "dotenv -e .env.test -- node scripts/reset-test-db.js",
    "test:migration:up": "dotenv -e .env.test -- node-pg-migrate up --config-file .migrations-config.json",
    "test:migration:down": "dotenv -e .env.test -- node-pg-migrate down --config-file .migrations-config.json",
    "test:migration:status": "dotenv -e .env.test -- node-pg-migrate status --config-file .migrations-config.json",
    "test:setup": "npm run services:test:up && npm run test:db:reset && npm run test:migration:up && npm run test:unit",
    "test:full": "npm run services:test:up && npm run test:db:reset && npm run test:migration:up && npm run test",
    "dev:db:reset": "dotenv -e .env.development -- node scripts/reset-dev-db.js",
    "dev:migration:up": "dotenv -e .env.development -- node-pg-migrate up --config-file .migrations-config.json",
    "dev:migration:down": "dotenv -e .env.development -- node-pg-migrate down --config-file .migrations-config.json",
    "dev:migration:status": "dotenv -e .env.development -- node-pg-migrate status --config-file .migrations-config.json",
    "dev:setup": "npm run services:dev:up && npm run dev:migration:up",
    "db:migrate": "dotenv -e .env.development -- node scripts/migrate.js",
    "db:seed": "dotenv -e .env.development -- node scripts/seed.js",
    "migration:create": "node-pg-migrate create --config-file .migrations-config.json",
    "migration:up": "dotenv -e .env.development -- node-pg-migrate up --config-file .migrations-config.json",
    "migration:down": "dotenv -e .env.development -- node-pg-migrate down --config-file .migrations-config.json"
  },
  "author": "Wander V. Bergami",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.3",
    "next": "^15.1.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2"
  }
}
